{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WhoAmI",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity", "cloudformation:ValidateTemplate", "cloudformation:GetTemplateSummary"],
      "Resource": "*"
    },
    {
      "Sid": "TheStack",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": "arn:aws:cloudformation:*:*:stack/quranlingo-voices/*"
    },
    {
      "Sid": "Buckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::quranlingo-voices-*", "arn:aws:s3:::quranlingo-voices-*/*"]
    },
    {
      "Sid": "VotesFunction",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:*:*:function:quranlingo-voices-*"
    },
    {
      "Sid": "VotesTable",
      "Effect": "Allow",
      "Action": "dynamodb:*",
      "Resource": "arn:aws:dynamodb:*:*:table/quranlingo-voices-*"
    },
    {
      "Sid": "FunctionLogs",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/quranlingo-voices-*"
    },
    {
      "Sid": "FunctionRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:PassRole", "iam:TagRole", "iam:UntagRole",
        "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:GetRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/quranlingo-voices-*"
    },
    {
      "Sid": "CloudFront",
      "Effect": "Allow",
      "Action": "cloudfront:*",
      "Resource": "*"
    }
  ]
}
